{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoyo",
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "hoyo.my.id",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
